# Statisk Next-export (out/) på Inleed (LiteSpeed/Apache). Ingen Node-server.
# trailingSlash: true → varje route är .../index.html och serveras via DirectoryIndex.

Options -Indexes -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Tvinga HTTPS (SSL termineras av hosten – ingen proxy.ts längre).
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

# OG-bilden exporteras som filen "opengraph-image" utan filändelse – tvinga rätt
# Content-Type så att sociala scrapers (Facebook/LinkedIn m.fl.) accepterar den.
<Files "opengraph-image">
  ForceType image/png
</Files>

# Cache: hashade assets cachas hårt, HTML revalideras alltid (freshness efter deploy).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|ico|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# LiteSpeeds SERVER-cache (LSCache) är ett eget lager ovanför Apache-headers ovan:
# den servar cachad HTML även efter rsync (och ignorerar ?cb=-query), så nya sidor
# efter deploy syntes med fördröjning (smoke-testet såg stale startsida utan stad-länkar).
# Stäng av LSCache för HTML/kataloger så att varje deploy syns direkt. Hashade assets
# är immutable och cachas ändå i webbläsaren – de påverkas inte.
<IfModule LiteSpeed>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} (/|\.html)$
  RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>
